{
  "name": "@vidimera/record",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Durable, content-bound, hash-chained, operator-replayable records of human confirmations over AI-drafted actions.",
  "license": "Apache-2.0",
  "author": "The Vidimera Authors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allafta/vidimera.git",
    "directory": "packages/record"
  },
  "engines": {
    "node": ">=22.16"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./probes": {
      "types": "./dist/probes/index.d.ts",
      "default": "./dist/probes/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
