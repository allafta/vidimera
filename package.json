{
  "name": "vidimera",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "typecheck": "tsc -p packages/record --noEmit && tsc -p packages/store-postgres --noEmit",
    "build": "tsc -p packages/record/tsconfig.build.json && tsc -p packages/store-postgres/tsconfig.build.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:strict": "biome check --error-on-warnings .",
    "test": "vitest run",
    "smoke": "node scripts/smoke-pack.mjs",
    "contract-scan": "node scripts/contract-scan.mjs",
    "api-sync": "node scripts/api-reference-sync.mjs",
    "docs-index-sync": "node scripts/docs-index-sync.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
