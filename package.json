{
  "name": "vidimera",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "typecheck": "tsc -p packages/record --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
